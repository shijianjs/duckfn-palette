plt_white_point_xyz: unknown white point 'nope'

statement error
SELECT plt_white_point_xy('d66');
----
plt_white_point_xy: unknown white point 'd66'

statement error
SELECT plt_adaptation_matrix('a','c','nope');
----
plt_adaptation_matrix: unknown adaptation method 'nope'

statement error
SELECT plt_lms_matrix('cat02');
----
plt_lms_matrix: unknown adaptation method 'cat02'

statement error
SELECT plt_lms_to_xyz_matrix('nope');
----
plt_lms_to_xyz_matrix: unknown adaptation method 'nope'

statement error
SELECT plt_diagonal_adaptation_matrix('a','nope','bradford');
----
plt_diagonal_adaptation_matrix: unknown white point 'nope'

statement error
SELECT plt_chromatic_adapt(plt_srgb(1,0,0),'d50','bradford');
