# name: test/sql/css.test
# description: 字符串互操作：palette 的十六进制读写与 csscolorparser 0.9 的 CSS Color Level 4
#   （src/extension/functions/css.rs）。
#   期望值来源：csscolorparser 0.9.0 的官方测试（tests/parser.rs、tests/to_css_xxx.rs、
#   tests/named_colors.rs），用 VALUES 表整批搬过来；其余为实跑输出。
# group: [duckfn_palette]

require duckfn_palette

query T
SELECT plt_css_formats();
----
[hex, rgb, hsl, hwb, lab, lch, oklab, oklch]

# ---- csscolorparser tests/parser.rs：解析结果（用 8 位十六进制比较） ----

query I
SELECT count(*) FROM (VALUES
  ('transparent', '#00000000'),
  ('TRANSPARENT', '#00000000'),
  ('#ff00ff64', '#ff00ff64'),
  ('ff00ff64', '#ff00ff64'),
  ('rgb(247,179,99)', '#f7b363'),
  ('rgb(50% 50% 50%)', '#808080'),
  ('rgb(247,179,99,0.37)', '#f7b3635e'),
  ('hsl(270 0% 50%)', '#808080'),
  ('hwb(0 50% 50%)', '#808080'),
  ('hsv(0 0% 50%)', '#808080'),
  ('hsv(0 0% 100%)', '#ffffff'),
  ('hsv(0 0% 19%)', '#303030')
) t(s, expected) WHERE plt_to_hex(plt_css_parse(s)) <> expected;
----
0

query I
SELECT count(*) FROM (VALUES
  ('lab(0% 0 0)', '#000000'),
  ('lab(100% 0 0)', '#ffffff'),
  ('lab(0% 0 0 / 0.5)', '#00000080'),
  ('lch(0% 0 0)', '#000000'),
  ('lch(100% 0 0)', '#ffffff'),
  ('lch(0% 0 0 / 0.5)', '#00000080')
) t(s, expected) WHERE plt_to_hex(plt_css_parse(s)) <> expected;
----
0

# red / lime / black / lime_alpha 四组等价写法
query I
SELECT count(*) FROM (VALUES
  ('#f00'), ('#f00f'), ('#ff0000'), ('#ff0000ff'), ('f00'), ('f00f'), ('ff0000'), ('ff0000ff'),
  ('rgb(255,0,0)'), ('rgb(255 0 0)'), ('rgb(700, -99, 0)'), ('rgb(100% 0% 0%)'),
  ('rgb(200% -10% -100%)'), ('rgb(255 0 0 100%)'), (' RGB ( 255 , 0 , 0 ) '),
  ('RGB( 255   0   0 )'), ('rgb(255	0
0)'), ('hsl(0,100%,50%)'), ('hsl(360 100% 50%)'), ('hwb(0 0% 0%)'),
  ('hwb(360deg 0% 0% 100%)'), ('hwb(360DEG 0% 0% 100%)'), ('hsv(0 100% 100%)'),
  ('oklab(0.62796, 0.22486, 0.12585)'), ('oklch(0.62796, 0.25768, 29.23388)'),
  ('color(srgb 1 0 0)'), ('color(srgb 100% 0% 0%)')
) t(s) WHERE plt_to_hex(plt_css_parse(s)) <> '#ff0000';
----
0

