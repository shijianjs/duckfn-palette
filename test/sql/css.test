# invalid_format：全部都不是合法颜色
query I
SELECT count(*) FILTER (plt_css_is_valid(s)) FROM (VALUES
  (''), ('bloodred'), ('#78afzd'), ('#fffff'), ('#a+5'), ('#+abc'), ('#+1+2+3'),
  ('#+1+2+3+4'), ('#+a+b+c'), ('ab+'), ('abc+'), ('+1+2+3'), ('+a+b+c+d'),
  ('rgb(255,0,0'), ('rgb(0,255,8s)'), ('rgb(100%,z9%,75%)'), ('rgb(255 0 0 0 0)'),
  ('rgb(255 0 0 0 / 0)'), ('rgb(,255,0,0)'), ('rgb(255,0,,0)'), ('rgb(255,0,0,)'),
  ('rgb(255,0,0/)'), ('rgb(255/0,0)'), ('cmyk(1 0 0)'), ('rgba(0 0)'),
  ('hsl(90'',100%,50%)'), ('hsl(360,70%,50%,90%,100%)'), ('hsl(deg 100% 50%)'),
  ('hsl(Xturn 100% 50%)'), ('hsl(Zgrad 100% 50%)'), ('hsl(180 1 x%)'), ('hsla(360)'),
  ('hwb(Xrad,50%,50%)'), ('hwb(270 0% 0% 0% 0%)'), ('hsv(120 100% 100% 1 50%)'),
  ('hsv(120 XXX 100%)'), ('lab(100%,0)'), ('lab(100% 0 X)'), ('lch(100%,0)'),
  ('lch(100% 0 X)'), ('oklab(0,0)'), ('oklab(0,0,x,0)'), ('oklch(0,0,0,0,0)'),
  ('oklch(0,0,0,x)'), ('color(srgb 1 0)'), ('color(srgb 1 0 0 1 1)'), ('æ'), ('#ß'),
  ('rgb(ß,0,0)'), ('rgb(nan 0 0)'), ('oklch(0.5 0.1 nan)'), ('rgb(inf 0 0)'),
  ('hsl(1e400deg 100% 50%)')
) t(s);
----
0

# 嵌套上限：32 层 rgb(from …) 合法，33 层非法（csscolorparser 的递归深度）
query II
WITH RECURSIVE n(d, s) AS (
  SELECT 0, '#ff0000' UNION ALL SELECT d + 1, 'rgb(from ' || s || ' r g b)' FROM n WHERE d < 33
)
SELECT count(*) FILTER (d = 32 AND plt_to_hex(plt_css_parse(s)) = '#ff0000'),
       count(*) FILTER (d = 33 AND NOT plt_css_is_valid(s))
FROM n;
----
1	1

# 嵌套 calc 同样在 32 层合法（32*5+2 = 162）、33 层非法
query II
WITH RECURSIVE c(d, s) AS (
  SELECT 0, '(3 - 1)' UNION ALL SELECT d + 1, '(5 + ' || s || ')' FROM c WHERE d < 33
), q(d, s) AS (
  SELECT d, 'rgb(from #000 calc' || s || ' 100 0)' FROM c
)
SELECT count(*) FILTER (d = 32 AND plt_to_hex(plt_css_parse(s)) = '#a26400'),
       count(*) FILTER (d = 33 AND NOT plt_css_is_valid(s))
FROM q;
----
1	1

