# equal：两组写法量化后相同
query I
SELECT count(*) FROM (VALUES
  ('transparent', 'rgb(0,0,0,0%)'),
  ('#FF9900', '#f90'),
  ('#aabbccdd', '#ABCD'),
  ('#BAD455', 'BAD455'),
  ('rgb(0 255 127 / 75%)', 'rgb(0,255,127,0.75)'),
  ('hwb(180 0% 60%)', 'hwb(180,0%,60%)'),
  ('hwb(290 30% 0%)', 'hwb(290 30 0)'),
  ('hsl(180,50%,27%)', 'hsl(180,50,27)'),
  ('hsl(120 50% 50%)', 'hsl(120 50 50)'),
  ('hwb(194 50% 20%)', 'hwb(194 50 20)'),
  ('rgb(255, 165, 0)', 'hsl(38.824 100% 50%)'),
  ('#7654CD', 'rgb(46.27% 32.94% 80.39%)'),
  ('#7654CD', 'lab(44.36% 36.05 -58.99)')
) t(a, b) WHERE plt_to_hex(plt_css_parse(a)) <> plt_to_hex(plt_css_parse(b));
----
0

