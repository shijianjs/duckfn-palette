# ---- 命名色（csscolorparser tests/named_colors.rs） ----

query I
SELECT count(*) FROM (VALUES
  ('aliceblue', '#f0f8ff'), ('bisque', '#ffe4c4'), ('black', '#000000'),
  ('chartreuse', '#7fff00'), ('coral', '#ff7f50'), ('crimson', '#dc143c'),
  ('dodgerblue', '#1e90ff'), ('firebrick', '#b22222'), ('gold', '#ffd700'),
  ('hotpink', '#ff69b4'), ('indigo', '#4b0082'), ('lavender', '#e6e6fa'),
  ('lime', '#00ff00'), ('plum', '#dda0dd'), ('red', '#ff0000'), ('salmon', '#fa8072'),
  ('skyblue', '#87ceeb'), ('tomato', '#ff6347'), ('violet', '#ee82ee'),
  ('yellowgreen', '#9acd32')
) t(name, hex)
WHERE plt_to_hex(plt_css_parse(name)) <> hex OR plt_css_name(plt_from_hex(hex)) <> name;
----
0

# 大小写不敏感；没有名字的 sRGB 颜色反查为 NULL
query IIII
SELECT plt_css_parse('red') = plt_css_parse('RED'),
       plt_css_parse('skyblue') = plt_css_parse('SkyBlue'),
       plt_css_name(plt_srgb(0.7,0.8,0.9)) IS NULL,
       plt_css_name(plt_srgb(1,0.5,0)) IS NULL;
----
true	true	true	true

# ---- 十六进制读写（palette 的 from_hex / LowerHex） ----

query TTTTTT
SELECT plt_to_hex(plt_from_hex('#f00')), plt_to_hex(plt_from_hex('f00')),
       plt_to_hex(plt_from_hex('#f008')), plt_to_hex(plt_from_hex('#ff000080')),
       plt_to_hex(plt_from_hex('ff000080')), plt_to_hex(plt_from_hex('#ff800080'));
----
#ff0000	#ff0000	#ff000088	#ff000080	#ff000080	#ff800080

query II
SELECT plt_from_hex('#78afzd') IS NULL, plt_from_hex(NULL) IS NULL;
----
true	true

# NULL 短路与类型
query III
SELECT plt_css_parse(NULL) IS NULL, plt_css_is_valid(NULL) IS NULL, plt_css_name(NULL) IS NULL;
----
true	true	true

query TT
SELECT typeof(plt_css_parse('#f00')), typeof(plt_to_hex(plt_srgb(1,0,0)));
----
STRUCT(space VARCHAR, c1 DOUBLE, c2 DOUBLE, c3 DOUBLE, alpha DOUBLE)	VARCHAR

statement error
SELECT plt_css_serialize(plt_srgb(1,0,0), 'nope');
----
unknown format 'nope'
