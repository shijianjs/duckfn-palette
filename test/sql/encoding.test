[{'space': yxy, 'c1': 0.64, 'c2': 0.33, 'c3': 0.212656, 'alpha': 1.0}, {'space': yxy, 'c1': 0.3, 'c2': 0.6, 'c3': 0.715158, 'alpha': 1.0}, {'space': yxy, 'c1': 0.15, 'c2': 0.06, 'c3': 0.072186, 'alpha': 1.0}]

