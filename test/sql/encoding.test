# name: test/sql/encoding.test
# description: 传输函数、解码/编码、白点、RGB 原色与 RGB↔XYZ 矩阵
# group: [palette]

require duckfn_palette

query T
SELECT plt_encoding_spaces()::VARCHAR;
----
[srgb, srgb_linear, srgb_gamma, adobe_rgb, adobe_rgb_linear, display_p3, display_p3_linear, dci_p3, dci_p3_linear, prophoto_rgb, prophoto_rgb_linear, rec709, rec709_linear, rec2020, rec2020_linear, luma, luma_linear, luma_gamma]

query T
SELECT plt_transfer_functions()::VARCHAR;
----
[linear, gamma_2_2, srgb, adobe_rgb, prophoto_rgb, p3_gamma, rec_oetf]

# ---- 每个空间使用的传输函数与白点 ----

query TTT
SELECT s, plt_transfer_function(s), plt_white_point_of(s)
FROM (SELECT unnest(plt_encoding_spaces()) AS s);
----
srgb	srgb	d65
srgb_linear	linear	d65
srgb_gamma	gamma_2_2	d65
adobe_rgb	adobe_rgb	d65
adobe_rgb_linear	linear	d65
display_p3	srgb	d65
display_p3_linear	linear	d65
dci_p3	p3_gamma	dci_p3
dci_p3_linear	linear	dci_p3
prophoto_rgb	prophoto_rgb	d50
prophoto_rgb_linear	linear	d50
rec709	rec_oetf	d65
rec709_linear	linear	d65
rec2020	rec_oetf	d65
rec2020_linear	linear	d65
luma	srgb	d65
luma_linear	linear	d65
luma_gamma	gamma_2_2	d65

# 名字规范化：大小写、连字符、空格
query III
SELECT plt_transfer_function('Display-P3') = 'srgb',
       plt_transfer_function('  SRGB ') = 'srgb',
       plt_white_point_of('PROPHOTO-RGB') = 'd50';
----
true	true	true

# ---- 解码 / 编码的已知值 ----

query TT
SELECT plt_decode('srgb', 0.5)::VARCHAR, plt_encode('srgb', 0.21404114048223255)::VARCHAR;
----
0.21404114048223244	0.5

query TTTT
SELECT plt_decode('adobe_rgb', 0.5)::VARCHAR, plt_encode('adobe_rgb', 0.5)::VARCHAR,
       plt_decode('prophoto_rgb', 0.5)::VARCHAR, plt_encode('prophoto_rgb', 0.5)::VARCHAR;
----
0.21775552814439456	0.7296583817678015	0.2871745887492587	0.6803950000871885

query TTTT
SELECT plt_decode('dci_p3', 0.5)::VARCHAR, plt_encode('dci_p3', 0.5)::VARCHAR,
       plt_decode('rec2020', 0.5)::VARCHAR, plt_encode('rec2020', 0.5)::VARCHAR;
----
0.16493848884661177	0.7659831786679869	0.2597194371011775	0.7054355530556183

query TT
SELECT plt_decode('srgb_gamma', 0.5)::VARCHAR, plt_encode('srgb_gamma', 0.5)::VARCHAR;
----
0.7297400528407231	0.217637640824031

# 端点
query IIII
SELECT plt_decode('srgb', 0.0)::DOUBLE, plt_decode('srgb', 1.0)::DOUBLE,
       plt_decode('srgb_linear', 0.42)::DOUBLE, plt_encode('srgb_linear', 0.42)::DOUBLE;
----
0.0	1.0	0.42	0.42

# 同传输函数的空间给出相同的值
query IIII
SELECT plt_decode('display_p3', 0.5) = plt_decode('srgb', 0.5),
       plt_decode('luma', 0.5) = plt_decode('srgb', 0.5),
       plt_decode('rec709', 0.5) = plt_decode('rec2020', 0.5),
       plt_decode('srgb_linear', 0.5) = 0.5;
----
true	true	true	true

# ---- 线性 ↔ 编码往返（palette 上游对 0..1 的 101 点断言，epsilon 1e-7） ----

query I
SELECT count(*) FROM generate_series(0, 100) g
WHERE abs(plt_decode('srgb', plt_encode('srgb', g / 100.0)) - g / 100.0) > 1e-7;
----
0

query I
SELECT count(*) FROM (
    SELECT s, g FROM (SELECT unnest(['srgb', 'adobe_rgb', 'display_p3', 'dci_p3',
                                     'prophoto_rgb', 'rec709', 'rec2020', 'luma']) AS s)
    CROSS JOIN generate_series(0, 100) AS gs(g)
) WHERE abs(plt_decode(s, plt_encode(s, g / 100.0)) - g / 100.0) > 1e-7;
----
0

# 反向：编码 → 解码 → 编码
query I
SELECT count(*) FROM (
    SELECT s, g FROM (SELECT unnest(['srgb', 'adobe_rgb', 'display_p3', 'dci_p3',
                                     'prophoto_rgb', 'rec709', 'rec2020', 'luma']) AS s)
    CROSS JOIN generate_series(0, 100) AS gs(g)
) WHERE abs(plt_encode(s, plt_decode(s, g / 100.0)) - g / 100.0) > 1e-7;
----
0

# ---- RGB 原色（yxy） ----

