# name: test/sql/blend.test
# description: palette 的 Blend（11 种）、Compose（6 种）与 Equations（自定义因子）
#   （src/extension/functions/blend.rs）。
#   期望值来源：palette 0.7.7 src/blend/test.rs 的 assert_relative_eq!（over/inside/outside/
#   atop/xor/plus 与 11 个混合模式，均用 LinSrgb/LinSrgba）；其余为实跑输出。
#   参数顺序与 palette 一致：第一个是源，第二个是背景。
# group: [duckfn_palette]

require duckfn_palette

# 模式与因子清单
query T
SELECT plt_blend_modes();
----
[multiply, screen, overlay, darken, lighten, dodge, burn, hard_light, soft_light, difference, exclusion]

query T
SELECT plt_compose_modes();
----
[over, inside, outside, atop, xor, plus]

query T
SELECT plt_blend_parameters();
----
[zero, one, source_color, one_minus_source_color, destination_color, one_minus_destination_color, source_alpha, one_minus_source_alpha, destination_alpha, one_minus_destination_alpha]

# ---- Compose：palette 的 over / inside / outside / atop / xor / plus 断言 ----

query TTTT
SELECT
  plt_components(plt_compose(plt_srgb_linear(0.5,0.0,0.3), plt_srgb_linear(1.0,0.2,0.0), 'over')),
  plt_components(plt_compose(plt_with_alpha(plt_srgb_linear(0.5,0.0,0.3),1.0), plt_with_alpha(plt_srgb_linear(1.0,0.2,0.0),0.5), 'over')),
  plt_components(plt_compose(plt_with_alpha(plt_srgb_linear(0.5,0.0,0.3),0.5), plt_with_alpha(plt_srgb_linear(1.0,0.2,0.0),0.5), 'over')),
  plt_alpha(plt_compose(plt_with_alpha(plt_srgb_linear(0.5,0.0,0.3),0.5), plt_with_alpha(plt_srgb_linear(1.0,0.2,0.0),0.5), 'over'));
----
[0.5, 0.0, 0.3]	[0.5, 0.0, 0.3]	[0.6666666666666666, 0.06666666666666667, 0.19999999999999998]	0.75

query TTT
SELECT
  plt_components(plt_compose(plt_with_alpha(plt_srgb_linear(0.5,0.0,0.3),1.0), plt_with_alpha(plt_srgb_linear(1.0,0.2,0.0),0.0), 'over')),
  plt_components(plt_compose(plt_srgb_linear(0.5,0.0,0.3), plt_srgb_linear(1.0,0.2,0.0), 'inside')),
  plt_components(plt_compose(plt_with_alpha(plt_srgb_linear(0.5,0.0,0.3),1.0), plt_with_alpha(plt_srgb_linear(1.0,0.2,0.0),0.5), 'inside'));
----
[0.5, 0.0, 0.3]	[0.5, 0.0, 0.3]	[0.5, 0.0, 0.3]

query TT
SELECT
  plt_components(plt_compose(plt_with_alpha(plt_srgb_linear(0.5,0.0,0.3),1.0), plt_with_alpha(plt_srgb_linear(1.0,0.2,0.0),0.0), 'inside')),
  plt_alpha(plt_compose(plt_with_alpha(plt_srgb_linear(0.5,0.0,0.3),1.0), plt_with_alpha(plt_srgb_linear(1.0,0.2,0.0),0.5), 'inside'));
----
[0.0, 0.0, 0.0]	0.5

query TTTT
SELECT
  plt_components(plt_compose(plt_srgb_linear(0.5,0.0,0.3), plt_srgb_linear(1.0,0.2,0.0), 'outside')),
  plt_components(plt_compose(plt_with_alpha(plt_srgb_linear(0.5,0.0,0.3),1.0), plt_with_alpha(plt_srgb_linear(1.0,0.2,0.0),0.5), 'outside')),
  plt_components(plt_compose(plt_with_alpha(plt_srgb_linear(0.5,0.0,0.3),1.0), plt_with_alpha(plt_srgb_linear(1.0,0.2,0.0),0.0), 'outside')),
  plt_alpha(plt_compose(plt_with_alpha(plt_srgb_linear(0.5,0.0,0.3),1.0), plt_with_alpha(plt_srgb_linear(1.0,0.2,0.0),0.5), 'outside'));
----
[0.0, 0.0, 0.0]	[0.5, 0.0, 0.3]	[0.5, 0.0, 0.3]	0.5

query TTTTT
SELECT
  plt_components(plt_compose(plt_srgb_linear(0.5,0.0,0.3), plt_srgb_linear(1.0,0.2,0.0), 'atop')),
  plt_components(plt_compose(plt_with_alpha(plt_srgb_linear(0.5,0.0,0.3),1.0), plt_with_alpha(plt_srgb_linear(1.0,0.2,0.0),0.5), 'atop')),
  plt_components(plt_compose(plt_with_alpha(plt_srgb_linear(0.5,0.0,0.3),0.5), plt_with_alpha(plt_srgb_linear(1.0,0.2,0.0),0.5), 'atop')),
  plt_components(plt_compose(plt_with_alpha(plt_srgb_linear(0.5,0.0,0.3),1.0), plt_with_alpha(plt_srgb_linear(1.0,0.2,0.0),0.0), 'atop')),
  plt_alpha(plt_compose(plt_with_alpha(plt_srgb_linear(0.5,0.0,0.3),0.5), plt_with_alpha(plt_srgb_linear(1.0,0.2,0.0),0.5), 'atop'));
