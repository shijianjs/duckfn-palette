  plt_components(plt_blend(plt_with_alpha(plt_srgb_linear(0.5,0.0,0.3),1.0), plt_with_alpha(plt_srgb_linear(0.5,0.2,0.0),0.0), 'screen'));
----
[0.75, 0.2, 0.3]	[0.625, 0.1, 0.3]	[0.5, 0.0, 0.3]

