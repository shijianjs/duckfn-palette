query TTTT
SELECT
  plt_components(plt_compose(plt_srgb_linear(0.5,0.0,0.3), plt_srgb_linear(1.0,0.2,0.0), 'plus')),
  plt_components(plt_compose(plt_with_alpha(plt_srgb_linear(0.5,0.0,0.3),1.0), plt_with_alpha(plt_srgb_linear(1.0,0.2,0.0),0.5), 'plus')),
  plt_components(plt_compose(plt_with_alpha(plt_srgb_linear(0.5,0.0,0.3),0.5), plt_with_alpha(plt_srgb_linear(1.0,0.2,0.0),0.5), 'plus')),
  plt_components(plt_compose(plt_with_alpha(plt_srgb_linear(0.5,0.0,0.3),1.0), plt_with_alpha(plt_srgb_linear(1.0,0.2,0.0),0.0), 'plus'));
