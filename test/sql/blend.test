query TT
SELECT
  plt_components(plt_blend(plt_srgb_linear(1.0,0.5,0.0), plt_srgb_linear(0.8,0.4,0.3), 'exclusion')),
  plt_alpha(plt_blend(plt_with_alpha(plt_srgb_linear(0.5,0.0,0.3),1.0), plt_with_alpha(plt_srgb_linear(1.0,0.2,0.0),0.5), 'exclusion'));
----
[0.19999999999999996, 0.5, 0.3]	1.0

# ---- Equations：source_alpha / one_minus_source_alpha 等价于 over ----

query TT
SELECT plt_components(plt_blend_equations(plt_with_alpha(plt_srgb_linear(0.5,0.0,0.3),0.5), plt_with_alpha(plt_srgb_linear(1.0,0.2,0.0),0.5), 'source_alpha', 'one_minus_source_alpha')),
       plt_alpha(plt_blend_equations(plt_with_alpha(plt_srgb_linear(0.5,0.0,0.3),0.5), plt_with_alpha(plt_srgb_linear(1.0,0.2,0.0),0.5), 'source_alpha', 'one_minus_source_alpha'));
----
[0.75, 0.1, 0.15]	0.5

query TT
SELECT plt_components(plt_blend_equations(plt_with_alpha(plt_srgb_linear(0.5,0.0,0.3),0.5), plt_with_alpha(plt_srgb_linear(1.0,0.2,0.0),0.5), 'one', 'one')),
       plt_alpha(plt_blend_equations(plt_with_alpha(plt_srgb_linear(0.5,0.0,0.3),0.5), plt_with_alpha(plt_srgb_linear(1.0,0.2,0.0),0.5), 'one', 'one'));
----
[0.75, 0.1, 0.15]	1.0

# 第二个颜色先转到第一个颜色的空间
query TT
SELECT plt_components(plt_blend(plt_srgb(1,0,0), plt_hsl(240,1,0.5), 'multiply')),
       plt_space(plt_blend(plt_srgb(1,0,0), plt_hsl(240,1,0.5), 'multiply'));
----
[6.46985278121015e-07, 0.0, 0.0]	srgb

# Compose / Equations 覆盖非 RGB 的可预乘空间（Xyz / Lab / Oklab）
query TT
SELECT plt_components(plt_compose(plt_xyz(0.5,0.4,0.3), plt_xyz(0.2,0.2,0.2), 'plus')),
       plt_components(plt_compose(plt_lab(50,20,-30), plt_lab(60,10,10), 'plus'));
----
[0.7, 0.6000000000000001, 0.5]	[110.0, 30.0, -20.0]

query T
SELECT plt_components(plt_compose(plt_oklab(0.5,0.1,0.1), plt_oklab(0.6,0.0,0.0), 'over'));
----
[0.5, 0.1, 0.1]

# NULL 短路
query III
SELECT plt_blend(NULL, plt_srgb(0,0,1), 'multiply') IS NULL,
       plt_compose(plt_srgb(1,0,0), NULL, 'over') IS NULL,
       plt_blend(plt_srgb(1,0,0), plt_srgb(0,0,1), NULL) IS NULL;
----
true	true	true

query T
SELECT typeof(plt_blend(plt_srgb(1,0,0), plt_srgb(0,0,1), 'multiply'));
----
STRUCT(space VARCHAR, c1 DOUBLE, c2 DOUBLE, c3 DOUBLE, alpha DOUBLE)

# 错误路径
statement error
SELECT plt_blend(plt_srgb(1,0,0), plt_srgb(0,0,1), 'nope');
----
unknown blend mode 'nope'

statement error
SELECT plt_compose(plt_srgb(1,0,0), plt_srgb(0,0,1), 'nope');
----
unknown compose mode 'nope'

statement error
SELECT plt_blend_equations(plt_srgb(1,0,0), plt_srgb(0,0,1), 'nope', 'one');
----
unknown blend factor 'nope'

statement error
SELECT plt_blend(plt_hsl(0,1,0.5), plt_srgb(1,0,0), 'multiply');
----
does not support the blend modes

statement error
SELECT plt_compose(plt_hsl(0,1,0.5), plt_hsl(0,1,0.5), 'over');
----
does not support composition
