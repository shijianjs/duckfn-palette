# ---- Blend：palette 的 11 个模式断言 ----

query TTT
SELECT
  plt_components(plt_blend(plt_srgb_linear(0.5,0.0,0.3), plt_srgb_linear(0.5,0.2,0.0), 'multiply')),
  plt_components(plt_blend(plt_with_alpha(plt_srgb_linear(0.5,0.0,0.3),1.0), plt_with_alpha(plt_srgb_linear(0.5,0.2,0.0),0.5), 'multiply')),
  plt_components(plt_blend(plt_with_alpha(plt_srgb_linear(0.5,0.0,0.3),1.0), plt_with_alpha(plt_srgb_linear(0.5,0.2,0.0),0.0), 'multiply'));
----
[0.25, 0.0, 0.0]	[0.375, 0.0, 0.15]	[0.5, 0.0, 0.3]

query TTT
SELECT
  plt_components(plt_blend(plt_srgb_linear(0.5,0.0,0.3), plt_srgb_linear(0.5,0.2,0.0), 'screen')),
