query T
SELECT plt_cam16_from_xyz(plt_convert(plt_from_hex('5588cc'), 'xyz'),
                          plt_cam16_default_params())::VARCHAR;
----
{'lightness': 45.54355957833133, 'chroma': 45.06730526739174, 'hue': 259.22753703022903, 'brightness': 132.9687124666152, 'colorfulness': 39.41069511583317, 'saturation': 54.441779933538335, 'alpha': 1.0}

# ---- 全属性往返 ----

query I
SELECT count(*) FROM (
    SELECT h, plt_to_hex(plt_convert(plt_cam16_to_xyz(
               plt_cam16_from_xyz(plt_convert(plt_from_hex(h), 'xyz'), plt_cam16_default_params()),
               plt_cam16_default_params()), 'srgb')) AS got
    FROM (SELECT unnest(['000000', 'ffffff', 'ff0000', '00ff00', '0000ff', '5588cc', '808080']) AS h) u
) WHERE got <> '#' || h;
----
0

# 全属性回算与 Jch 部分类型一致（palette 的 converts_with_jch 断言）
query T
SELECT plt_to_hex(plt_convert(plt_cam16_to_xyz(
           plt_cam16_from_xyz(plt_convert(plt_from_hex('5588cc'), 'xyz'), plt_cam16_default_params()),
           plt_cam16_default_params()), 'srgb'));
----
#5588cc

# ---- 八个部分空间 ----

query T
SELECT sp || ':' || plt_cam16_partial_from_xyz(
              plt_convert(plt_from_hex('5588cc'), 'xyz'), sp, plt_cam16_default_params()).c1::VARCHAR
       || ',' || plt_cam16_partial_from_xyz(
              plt_convert(plt_from_hex('5588cc'), 'xyz'), sp, plt_cam16_default_params()).c2::VARCHAR
       || ',' || plt_cam16_partial_from_xyz(
              plt_convert(plt_from_hex('5588cc'), 'xyz'), sp, plt_cam16_default_params()).c3::VARCHAR
FROM (SELECT unnest(plt_cam16_spaces()) AS sp) s;
----
cam16_jch:45.54355957833133,45.06730526739174,259.22753703022903
cam16_jmh:45.54355957833133,39.41069511583317,259.22753703022903
cam16_jsh:45.54355957833133,54.441779933538335,259.22753703022903
cam16_qch:132.9687124666152,45.06730526739174,259.22753703022903
cam16_qmh:132.9687124666152,39.41069511583317,259.22753703022903
cam16_qsh:132.9687124666152,54.441779933538335,259.22753703022903
cam16_ucs_jab:58.70773628631121,-5.2555728187173445,-27.622797846121436
cam16_ucs_jmh:58.70773628631121,28.118321544866998,259.22753703022903

# 部分空间往返（8 空间 × 7 色）
query I
SELECT count(*) FROM (
    SELECT sp, h, plt_to_hex(plt_convert(plt_cam16_partial_to_xyz(
               plt_cam16_partial_from_xyz(plt_convert(plt_from_hex(h), 'xyz'), sp,
                                          plt_cam16_default_params()),
               plt_cam16_default_params()), 'srgb')) AS got
    FROM (SELECT unnest(['000000', 'ffffff', 'ff0000', '00ff00', '0000ff', '5588cc', '808080']) AS h) u
    CROSS JOIN (SELECT unnest(plt_cam16_spaces()) AS sp) s
) WHERE got <> '#' || h;
----
0

# 与 plt_convert 的默认条件一致
query IIII
SELECT plt_convert(plt_from_hex('5588cc'), 'cam16_jch')
     = plt_cam16_partial_from_xyz(plt_convert(plt_from_hex('5588cc'), 'xyz'), 'cam16_jch',
                                  plt_cam16_default_params()),
       plt_convert(plt_from_hex('5588cc'), 'cam16_ucs_jab')
     = plt_cam16_partial_from_xyz(plt_convert(plt_from_hex('5588cc'), 'xyz'), 'cam16_ucs_jab',
                                  plt_cam16_default_params()),
       plt_to_hex(plt_convert(plt_convert(plt_from_hex('5588cc'), 'cam16_qsh'), 'srgb')) = '#5588cc',
       plt_to_hex(plt_convert(plt_cam16_partial_to_xyz(plt_cam16_jch(50, 40, 120),
                          plt_cam16_default_params()), 'srgb')) = '#8b9a46';
----
true	true	true	true

# ---- 自定义观察条件确实改变结果 ----

query T
SELECT plt_cam16_from_xyz(plt_xyz(0.2, 0.2, 0.2), plt_cam16_params('d65', 40, 0.2, 'average', 0.8))::VARCHAR;
----
{'lightness': 41.694331444686, 'chroma': 5.596967700872483, 'hue': 27.78281974649811, 'brightness': 127.1883077308742, 'colorfulness': 4.894465873286886, 'saturation': 19.616840361317486, 'alpha': 1.0}

query T
SELECT plt_cam16_partial_from_xyz(plt_xyz(0.2, 0.2, 0.2), 'cam16_jch',
                                  plt_cam16_params('d50', 30, 0.4, 'dim'))::VARCHAR;
----
{'space': cam16_jch, 'c1': 43.941360244546644, 'c2': 8.386922376142468, 'c3': 299.5328365858261, 'alpha': 1.0}

query II
SELECT plt_cam16_from_xyz(plt_xyz(0.2, 0.2, 0.2), plt_cam16_params('d65', 40, 0.2, 'average'))
    <> plt_cam16_from_xyz(plt_xyz(0.2, 0.2, 0.2), plt_cam16_params('d65', 40, 0.2, 'average', 0.8)),
       plt_cam16_from_xyz(plt_xyz(0.2, 0.2, 0.2), plt_cam16_params('d65', 40, 0.2, '12.5'))
    <> plt_cam16_from_xyz(plt_xyz(0.2, 0.2, 0.2), plt_cam16_default_params());
----
true	true

# alpha 保留
query II
SELECT plt_cam16_from_xyz(plt_with_alpha(plt_xyz(0.2, 0.2, 0.2), 0.25), plt_cam16_default_params()).alpha::DOUBLE,
       plt_cam16_to_xyz(plt_cam16_from_xyz(plt_with_alpha(plt_xyz(0.2, 0.2, 0.2), 0.25),
                        plt_cam16_default_params()), plt_cam16_default_params()).alpha::DOUBLE;
----
0.25	0.25

# ---- 类型 / NULL / 错误 ----

query TTT
SELECT typeof(plt_cam16_default_params()),
       typeof(plt_cam16_from_xyz(plt_xyz(0.2, 0.2, 0.2), plt_cam16_default_params())),
       typeof(plt_cam16_partial_from_xyz(plt_xyz(0.2, 0.2, 0.2), 'cam16_jch',
                                         plt_cam16_default_params()));
----
STRUCT(white_x DOUBLE, white_y DOUBLE, white_z DOUBLE, adapting_luminance DOUBLE, background_luminance DOUBLE, surround DOUBLE, discounting DOUBLE, discounting_auto BOOLEAN)	STRUCT(lightness DOUBLE, chroma DOUBLE, hue DOUBLE, brightness DOUBLE, colorfulness DOUBLE, saturation DOUBLE, alpha DOUBLE)	STRUCT(space VARCHAR, c1 DOUBLE, c2 DOUBLE, c3 DOUBLE, alpha DOUBLE)

query IIII
SELECT plt_cam16_params(NULL, 40, 0.2, 'average') IS NULL,
       plt_cam16_params_xyz(NULL, 1, 1.1, 40, 0.2, 'average') IS NULL,
       plt_cam16_from_xyz(NULL, plt_cam16_default_params()) IS NULL,
       plt_cam16_from_xyz(plt_xyz(0.2, 0.2, 0.2), NULL) IS NULL;
----
true	true	true	true

query II
SELECT plt_cam16_to_xyz(NULL, plt_cam16_default_params()) IS NULL,
       plt_cam16_partial_to_xyz(NULL, plt_cam16_default_params()) IS NULL;
----
true	true

statement error
SELECT plt_cam16_from_xyz(plt_srgb(1, 0, 0), plt_cam16_default_params());
----
plt_cam16_from_xyz: expected a color in the 'xyz' space

statement error
SELECT plt_cam16_partial_to_xyz(plt_srgb(1, 0, 0), plt_cam16_default_params());
----
plt_cam16_partial_to_xyz: expected a CAM16 space

statement error
SELECT plt_cam16_partial_from_xyz(plt_xyz(0.2, 0.2, 0.2), 'cam16_nope', plt_cam16_default_params());
----
plt_cam16_partial_from_xyz: unknown color space 'cam16_nope'

statement error
SELECT plt_cam16_params('d65', 40, 0.2, 'nope');
----
plt_cam16_params: unknown surround 'nope'

statement error
SELECT plt_cam16_params('nope', 40, 0.2, 'average');
----
plt_cam16_params: unknown white point 'nope'
